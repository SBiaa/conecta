// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
   provider = "prisma-client-js"
}

datasource db {
   provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  PROFESSOR
  ASSOCIADO
}

enum Status {
  ATIVO
  INATIVO
}

enum StatusPagamento {
  PENDENTE
  PAGA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
}

enum TipoPagamento {
  MENSALIDADE
  INSCRICAO
}

enum ExameMedico {
  APTO
  NAO_APTO
  AGUARDANDO
}

enum TipoPost {
  GERAL
  PROJETO
  TURMA
}

enum TipoReacao {
  CURTIR
  AMEI
  FORCA
  PARABENS
}

enum LocalDor {
  JOELHO
  LOMBAR
  CERVICAL
  OMBRO
  QUADRIL
  TORNOZELO
  PUNHO
  OUTRO
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  cpf       String   @unique
  senha     String
  email     String?  @unique
  telefone  String?
  fotoUrl   String?  // data URL (base64) da foto de perfil, já redimensionada no navegador
  papel     Papel    @default(ASSOCIADO)
  status    Status   @default(ATIVO)
  criadoEm  DateTime @default(now())
cep         String?
  logradouro  String?   // a rua
  numero      String?   // texto, não número — por causa de "123A", "s/n"
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?   // o estado, 2 letras (SP, RJ...)
  rg               String?
  dataNascimento   DateTime?
  tomaMedicamento  Boolean   @default(false)
  qualMedicamento  String?
  matriculas Matricula[]
  turmasComoProfessor Turma[]    @relation("TurmaProfessor")
  presencasRegistradas Presenca[] @relation("PresencaRegistradaPor")
  posts Post[]
  reacoes Reacao[]
  comentarios Comentario[]
  compras Venda[]
  alturaCm         Int?   // altura em centimetros, pra calcular o IMC
  registrosSaude   RegistroSaude[]
  avaliacoes       Avaliacao[]
  avaliacoesFeitas Avaliacao[] @relation("AvaliacaoRegistradaPor")
}

model Projeto {
  id       Int      @id @default(autoincrement())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  turmas Turma[]
  posts  Post[]
}

model Turma {
  id        Int      @id @default(autoincrement())
  nome      String
  projetoId Int
  projeto   Projeto  @relation(fields: [projetoId], references: [id])
  criadoEm  DateTime @default(now())

  matriculaTurmas MatriculaTurma[]
    dias      DiaSemana[]
  horario   String?

  professorId String?
  professor   Usuario? @relation("TurmaProfessor", fields: [professorId], references: [id])
  presencas   Presenca[]
  posts       Post[]
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Matricula {
  id                Int       @id @default(autoincrement())
  usuarioId         String
  usuario           Usuario   @relation(fields: [usuarioId], references: [id])
  turmasVinculadas  MatriculaTurma[]
  frequenciaSemanal Int?
  ativa             Boolean   @default(true)
  dataInicio        DateTime  @default(now())
  encerradaEm       DateTime?
exameMedico  ExameMedico  @default(AGUARDANDO)
  pagamentos Pagamento[]
  presencas  Presenca[]
}

model MatriculaTurma {
  id          Int       @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula @relation(fields: [matriculaId], references: [id])
  turmaId     Int
  turma       Turma     @relation(fields: [turmaId], references: [id])
  dias        DiaSemana[]

  @@unique([matriculaId, turmaId])
}

model Presenca {
  id              Int       @id @default(autoincrement())
  matriculaId     Int
  matricula       Matricula @relation(fields: [matriculaId], references: [id])
  turmaId         Int
  turma           Turma     @relation(fields: [turmaId], references: [id])
  data            DateTime  @db.Date
  presente        Boolean
  registradoPorId String
  registradoPor   Usuario   @relation("PresencaRegistradaPor", fields: [registradoPorId], references: [id])
  criadoEm        DateTime  @default(now())

  @@unique([matriculaId, data])
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  matriculaId    Int
  matricula      Matricula       @relation(fields: [matriculaId], references: [id])
  tipo           TipoPagamento   @default(MENSALIDADE)
  valor          Decimal         @db.Decimal(10, 2)
  mesReferencia  String
  vencimento     DateTime
  status         StatusPagamento @default(PENDENTE)
  dataPagamento  DateTime?
  formaPagamento FormaPagamento?
  criadoEm       DateTime        @default(now())
}

model Produto {
  id       Int      @id @default(autoincrement())
  nome     String
  preco    Decimal  @db.Decimal(10, 2)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  vendas Venda[]
}

model Venda {
  id             Int            @id @default(autoincrement())
  produtoId      Int
  produto        Produto        @relation(fields: [produtoId], references: [id])
  quantidade     Int
  valorUnitario  Decimal        @db.Decimal(10, 2)
  valorTotal     Decimal        @db.Decimal(10, 2)
  usuarioId      String?
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id])
  data           DateTime
  formaPagamento FormaPagamento
  criadoEm       DateTime       @default(now())
}

model CategoriaDespesa {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  despesas Despesa[]
}

model Despesa {
  id          Int              @id @default(autoincrement())
  descricao   String
  categoriaId Int
  categoria   CategoriaDespesa @relation(fields: [categoriaId], references: [id])
  valor       Decimal          @db.Decimal(10, 2)
  data        DateTime
  criadoEm    DateTime         @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  conteudo  String
  tipo      TipoPost
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id])
  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id])
  turmaId   Int?
  turma     Turma?   @relation(fields: [turmaId], references: [id])
  criadoEm  DateTime @default(now())

  reacoes     Reacao[]
  comentarios Comentario[]
}

// Uma reacao por pessoa por post: reagir de novo troca a reacao anterior.
// Quem quer tirar a reacao manda DELETE — nao existe reacao "neutra".
model Reacao {
  id        Int        @id @default(autoincrement())
  postId    Int
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  tipo      TipoReacao
  criadoEm  DateTime   @default(now())
  editadoEm DateTime   @updatedAt

  @@unique([postId, usuarioId])
  @@index([postId])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id])
  conteudo  String
  criadoEm  DateTime @default(now())

  @@index([postId, criadoEm])
}

// Dado de saude da associada. Fica no Usuario, e nao na Matricula, porque o
// historico dela nao deixa de existir quando uma matricula encerra.
// Um registro por dia: registrar de novo no mesmo dia atualiza o anterior.
model RegistroSaude {
  id         Int        @id @default(autoincrement())
  usuarioId  String
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  data       DateTime   @db.Date
  peso       Decimal?   @db.Decimal(5, 2)
  nivelDor   Int?       // 0 (sem dor) a 5 (dor forte)
  locaisDor  LocalDor[]
  disposicao Int?       // 1 (muito mal) a 5 (muito bem)
  observacao String?

  // Composicao corporal: vem da balanca junto com o peso, na mesma pesagem.
  // Hoje a associada digita o que le no app da balanca; se um dia houver
  // integracao, e aqui que os numeros caem.
  percentualGordura Decimal? @db.Decimal(4, 1)
  percentualAgua    Decimal? @db.Decimal(4, 1)
  massaMuscular     Decimal? @db.Decimal(5, 2) // kg
  massaOssea        Decimal? @db.Decimal(4, 2) // kg
  gorduraVisceral   Int?                        // indice, 1 a 59
  taxaMetabolica    Int?                        // kcal por dia

  criadoEm   DateTime   @default(now())
  editadoEm  DateTime   @updatedAt

  @@unique([usuarioId, data])
  @@index([usuarioId, data])
}

// Avaliacao fisica: as circunferencias de fita metrica, tiradas pela professora
// ou pela coordenacao. Fica separada do RegistroSaude de proposito — aquele e o
// check-in diario que a propria associada preenche, este e um evento periodico
// feito por outra pessoa, e guarda quem mediu.
model Avaliacao {
  id              Int      @id @default(autoincrement())
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  data            DateTime @db.Date
  registradoPorId String
  registradoPor   Usuario  @relation("AvaliacaoRegistradaPor", fields: [registradoPorId], references: [id])

  cintura     Decimal? @db.Decimal(5, 1) // cm
  quadril     Decimal? @db.Decimal(5, 1)
  braco       Decimal? @db.Decimal(5, 1)
  coxa        Decimal? @db.Decimal(5, 1)
  panturrilha Decimal? @db.Decimal(5, 1)
  torax       Decimal? @db.Decimal(5, 1)

  observacao String?
  criadoEm   DateTime @default(now())
  editadoEm  DateTime @updatedAt

  @@unique([usuarioId, data])
  @@index([usuarioId, data])
}
