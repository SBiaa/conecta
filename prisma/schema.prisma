// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  PROFESSOR
  ASSOCIADO
  CONVIDADO // vai numa viagem sem ser associada: só nome e celular, entra pelo link da viagem
}

enum Status {
  ATIVO
  INATIVO
}

enum StatusPagamento {
  PENDENTE
  PAGA
  CANCELADA // matrícula encerrada com a cobrança ainda em aberto: não é mais cobrada
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO
  ABONADO
}

enum TipoPagamento {
  MENSALIDADE
  INSCRICAO
}

enum ExameMedico {
  APTO
  NAO_APTO
  AGUARDANDO
}

enum TipoPost {
  GERAL
  PROJETO
  TURMA
}

enum TipoReacao {
  CURTIR
  AMEI
  FORCA
  PARABENS
}

enum LocalDor {
  JOELHO
  LOMBAR
  CERVICAL
  OMBRO
  QUADRIL
  TORNOZELO
  PUNHO
  OUTRO
}

model Usuario {
  id                   String          @id @default(uuid())
  nome                 String
  cpf                  String?         @unique // dependente (criança) pode não ter CPF
  senha                String? // dependente não tem login: quem acessa é o responsável
  email                String?         @unique
  telefone             String?
  fotoUrl              String? // data URL (base64) da foto de perfil, já redimensionada no navegador
  papel                Papel           @default(ASSOCIADO)
  status               Status          @default(ATIVO)
  criadoEm             DateTime        @default(now())
  cep                  String?
  logradouro           String? // a rua
  numero               String? // texto, não número — por causa de "123A", "s/n"
  complemento          String?
  bairro               String?
  cidade               String?
  uf                   String? // o estado, 2 letras (SP, RJ...)
  rg                   String?
  dataNascimento       DateTime?
  tomaMedicamento      Boolean         @default(false)
  qualMedicamento      String?
  matriculas           Matricula[]
  turmasComoProfessor  Turma[]         @relation("TurmaProfessor")
  presencasRegistradas Presenca[]      @relation("PresencaRegistradaPor")
  posts                Post[]
  reacoes              Reacao[]
  comentarios          Comentario[]
  compras              Venda[]
  alturaCm             Int? // altura em centimetros, pra calcular o IMC
  registrosSaude       RegistroSaude[]
  registrosSaudeFeitos RegistroSaude[] @relation("RegistroSaudeRegistradoPor")
  avaliacoes           Avaliacao[]
  avaliacoesFeitas     Avaliacao[]     @relation("AvaliacaoRegistradaPor")
  pagamentosEditados   Pagamento[]     @relation("PagamentoEditadoPor")

  // Criança (ou outro dependente) cadastrada como pessoa própria, ligada ao
  // adulto responsável. Matrícula, presença e nível ficam no dependente; o
  // responsável só enxerga. Um adulto sem responsável continua como antes.
  responsavelId String?
  responsavel   Usuario?  @relation("ResponsavelDependente", fields: [responsavelId], references: [id])
  dependentes   Usuario[] @relation("ResponsavelDependente")

  niveisNatacao       NivelNatacaoRegistro[]
  niveisNatacaoFeitos NivelNatacaoRegistro[] @relation("NivelNatacaoRegistradoPor")

  viagens           ViagemParticipante[]
  viagemAvisos      ViagemAviso[]
  viagemChecklist   ViagemChecklistMarcado[]
  viagemMidias      ViagemMidia[]
  viagemMidiasNotas ViagemMidia[]            @relation("ViagemMidiaAvaliadaPor")
}

model Projeto {
  id       Int      @id @default(autoincrement())
  nome     String
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  // Valor da taxa de inscrição sugerido na matrícula deste projeto.
  taxaInscricao Decimal        @default(15) @db.Decimal(10, 2)
  planos        PlanoProjeto[]

  turmas Turma[]
  posts  Post[]
}

model Turma {
  id        Int      @id @default(autoincrement())
  nome      String
  projetoId Int
  projeto   Projeto  @relation(fields: [projetoId], references: [id])
  criadoEm  DateTime @default(now())

  matriculaTurmas MatriculaTurma[]
  dias            DiaSemana[]
  horario         String?

  professorId String?
  professor   Usuario?   @relation("TurmaProfessor", fields: [professorId], references: [id])
  presencas   Presenca[]
  posts       Post[]
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Matricula {
  id                Int              @id @default(autoincrement())
  usuarioId         String
  usuario           Usuario          @relation(fields: [usuarioId], references: [id])
  turmasVinculadas  MatriculaTurma[]
  frequenciaSemanal Int?
  ativa             Boolean          @default(true)
  dataInicio        DateTime         @default(now())
  encerradaEm       DateTime?
  exameMedico       ExameMedico      @default(AGUARDANDO)
  pagamentos        Pagamento[]
  presencas         Presenca[]
}

model MatriculaTurma {
  id          Int         @id @default(autoincrement())
  matriculaId Int
  matricula   Matricula   @relation(fields: [matriculaId], references: [id])
  turmaId     Int
  turma       Turma       @relation(fields: [turmaId], references: [id])
  dias        DiaSemana[]

  @@unique([matriculaId, turmaId])
}

model Presenca {
  id              Int       @id @default(autoincrement())
  matriculaId     Int
  matricula       Matricula @relation(fields: [matriculaId], references: [id])
  turmaId         Int
  turma           Turma     @relation(fields: [turmaId], references: [id])
  data            DateTime  @db.Date
  presente        Boolean
  registradoPorId String
  registradoPor   Usuario   @relation("PresencaRegistradaPor", fields: [registradoPorId], references: [id])
  criadoEm        DateTime  @default(now())

  @@unique([matriculaId, data])
}

model Pagamento {
  id             Int             @id @default(autoincrement())
  matriculaId    Int
  matricula      Matricula       @relation(fields: [matriculaId], references: [id])
  tipo           TipoPagamento   @default(MENSALIDADE)
  valor          Decimal         @db.Decimal(10, 2)
  mesReferencia  String
  vencimento     DateTime
  status         StatusPagamento @default(PENDENTE)
  dataPagamento  DateTime?
  formaPagamento FormaPagamento?
  criadoEm       DateTime        @default(now())

  // Preenchidos só quando a coordenação corrige um pagamento já lançado
  // (ex.: valor digitado errado) — não existe histórico completo de mudanças,
  // só o registro da última correção. Setados manualmente (não @updatedAt)
  // pra não disparar em toda escrita, como marcarComoPaga.
  editadoEm    DateTime?
  editadoPorId String?
  editadoPor   Usuario?  @relation("PagamentoEditadoPor", fields: [editadoPorId], references: [id])
}

model Produto {
  id       Int      @id @default(autoincrement())
  nome     String
  preco    Decimal  @db.Decimal(10, 2)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  vendas Venda[]
}

model Venda {
  id             Int            @id @default(autoincrement())
  produtoId      Int
  produto        Produto        @relation(fields: [produtoId], references: [id])
  quantidade     Int
  valorUnitario  Decimal        @db.Decimal(10, 2)
  valorTotal     Decimal        @db.Decimal(10, 2)
  usuarioId      String?
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id])
  data           DateTime
  formaPagamento FormaPagamento
  criadoEm       DateTime       @default(now())
}

model CategoriaDespesa {
  id       Int      @id @default(autoincrement())
  nome     String   @unique
  ativa    Boolean  @default(true)
  criadoEm DateTime @default(now())

  despesas Despesa[]
}

model Despesa {
  id          Int              @id @default(autoincrement())
  descricao   String
  categoriaId Int
  categoria   CategoriaDespesa @relation(fields: [categoriaId], references: [id])
  valor       Decimal          @db.Decimal(10, 2)
  data        DateTime
  criadoEm    DateTime         @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  conteudo  String
  tipo      TipoPost
  autorId   String
  autor     Usuario  @relation(fields: [autorId], references: [id])
  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id])
  turmaId   Int?
  turma     Turma?   @relation(fields: [turmaId], references: [id])
  criadoEm  DateTime @default(now())

  reacoes     Reacao[]
  comentarios Comentario[]
}

// Uma reacao por pessoa por post: reagir de novo troca a reacao anterior.
// Quem quer tirar a reacao manda DELETE — nao existe reacao "neutra".
model Reacao {
  id        Int        @id @default(autoincrement())
  postId    Int
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  tipo      TipoReacao
  criadoEm  DateTime   @default(now())
  editadoEm DateTime   @updatedAt

  @@unique([postId, usuarioId])
  @@index([postId])
}

model Comentario {
  id       Int      @id @default(autoincrement())
  postId   Int
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  autorId  String
  autor    Usuario  @relation(fields: [autorId], references: [id])
  conteudo String
  criadoEm DateTime @default(now())

  @@index([postId, criadoEm])
}

// Dado de saude da associada. Fica no Usuario, e nao na Matricula, porque o
// historico dela nao deixa de existir quando uma matricula encerra.
// Um registro por dia: registrar de novo no mesmo dia atualiza o anterior.
// Quem registra e a professora da turma (ou a coordenacao) — igual a
// Avaliacao. A associada so le o resultado no Meu Progresso.
model RegistroSaude {
  id        Int      @id @default(autoincrement())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  data      DateTime @db.Date

  // Quem mediu/lançou este registro — a professora, na balança da turma.
  // Fica opcional porque registros antigos foram digitados pela própria
  // associada, antes dessa mudança, e não têm autor pra preencher aqui.
  registradoPorId String?
  registradoPor   Usuario? @relation("RegistroSaudeRegistradoPor", fields: [registradoPorId], references: [id])

  peso       Decimal?   @db.Decimal(5, 2)
  nivelDor   Int? // 0 (sem dor) a 5 (dor forte)
  locaisDor  LocalDor[]
  disposicao Int? // 1 (muito mal) a 5 (muito bem)
  observacao String?

  // Composicao corporal: vem da balanca junto com o peso, na mesma pesagem.
  // Hoje a associada digita o que le no app da balanca; se um dia houver
  // integracao, e aqui que os numeros caem.
  percentualGordura Decimal? @db.Decimal(4, 1)
  percentualAgua    Decimal? @db.Decimal(4, 1)
  massaMuscular     Decimal? @db.Decimal(5, 2) // kg
  massaOssea        Decimal? @db.Decimal(4, 2) // kg
  gorduraVisceral   Int? // indice, 1 a 59
  taxaMetabolica    Int? // kcal por dia

  criadoEm  DateTime @default(now())
  editadoEm DateTime @updatedAt

  @@unique([usuarioId, data])
  @@index([usuarioId, data])
}

// Avaliacao fisica: as circunferencias de fita metrica, tiradas pela professora
// ou pela coordenacao. Fica separada do RegistroSaude de proposito — aquele e
// o check-in do dia (peso, composicao, dor, disposicao), este e um evento
// periodico de fita metrica. Os dois guardam quem mediu.
model Avaliacao {
  id              Int      @id @default(autoincrement())
  usuarioId       String
  usuario         Usuario  @relation(fields: [usuarioId], references: [id])
  data            DateTime @db.Date
  registradoPorId String
  registradoPor   Usuario  @relation("AvaliacaoRegistradaPor", fields: [registradoPorId], references: [id])

  cintura     Decimal? @db.Decimal(5, 1) // cm
  quadril     Decimal? @db.Decimal(5, 1)
  braco       Decimal? @db.Decimal(5, 1)
  coxa        Decimal? @db.Decimal(5, 1)
  panturrilha Decimal? @db.Decimal(5, 1)
  torax       Decimal? @db.Decimal(5, 1)

  observacao String?
  criadoEm   DateTime @default(now())
  editadoEm  DateTime @updatedAt

  @@unique([usuarioId, data])
  @@index([usuarioId, data])
}

enum NivelNatacao {
  ADAPTACAO // adaptação ao meio líquido
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

// Nível da criança na natação. Cada linha e uma mudanca de nivel (ou uma
// reavaliacao); o nivel atual e o registro mais recente. Fica no Usuario, e nao
// na Matricula, pelo mesmo motivo do RegistroSaude: a evolucao nao some quando
// a matricula encerra. Quem registra e a professora da turma ou a coordenacao.
model NivelNatacaoRegistro {
  id              Int          @id @default(autoincrement())
  usuarioId       String
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])
  data            DateTime     @db.Date
  nivel           NivelNatacao
  observacao      String?
  registradoPorId String
  registradoPor   Usuario      @relation("NivelNatacaoRegistradoPor", fields: [registradoPorId], references: [id])
  criadoEm        DateTime     @default(now())

  @@index([usuarioId, data])
}

// Preço da mensalidade por plano (aulas por semana) de cada projeto. A
// Matricula guarda so as aulas por semana; o valor vem daqui na hora de gerar a
// cobranca. Mudar o preco so vale para cobrancas geradas dali em diante: o
// Pagamento ja carrega o valor que foi cobrado.
model PlanoProjeto {
  id             Int     @id @default(autoincrement())
  projetoId      Int
  projeto        Projeto @relation(fields: [projetoId], references: [id])
  aulasPorSemana Int
  valorMensal    Decimal @db.Decimal(10, 2)

  @@unique([projetoId, aulasPorSemana])
}

// ---------------------------------------------------------------------------
// Viagem: área só de quem vai (a coordenação escolhe a lista). Junta as
// informações práticas (cronograma, avisos, checklist) e a galeria de fotos e
// vídeos, com o concurso de quem manda o melhor conteúdo. Genérica pra poder
// ter mais de uma viagem ao longo dos anos.
// ---------------------------------------------------------------------------

enum TipoMidia {
  FOTO
  VIDEO
}

model Viagem {
  id          Int       @id @default(autoincrement())
  nome        String
  destino     String?
  dataSaida   DateTime?
  dataRetorno DateTime?
  localSaida  String? // onde o ônibus sai
  descricao   String?
  premio      String? // o que ganha quem fizer mais pontos no concurso
  ativa       Boolean   @default(true)
  criadoEm    DateTime  @default(now())
  // Código do link mandado no grupo (/v/<codigo>). Quem abre digita o celular
  // e entra só nesta viagem. Trocar o código derruba todos os acessos por link.
  codigoAcesso String?  @unique

  participantes ViagemParticipante[]
  eventos       ViagemEvento[]
  avisos        ViagemAviso[]
  checklist     ViagemChecklistItem[]
  midias        ViagemMidia[]
}

model ViagemParticipante {
  id        Int     @id @default(autoincrement())
  viagemId  Int
  viagem    Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  // Celular da lista da viagem: é com ele que a pessoa entra pelo link. Fica
  // aqui (e não no cadastro) pra não mexer no telefone da associada.
  celular   String?

  @@unique([viagemId, usuarioId])
  @@index([usuarioId])
}

// Cronograma. A saída do ônibus é só mais um evento — a tela destaca o
// próximo compromisso no topo.
model ViagemEvento {
  id         Int      @id @default(autoincrement())
  viagemId   Int
  viagem     Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  inicio     DateTime
  titulo     String
  local      String?
  observacao String?

  @@index([viagemId, inicio])
}

model ViagemAviso {
  id         Int      @id @default(autoincrement())
  viagemId   Int
  viagem     Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  titulo     String
  texto      String
  importante Boolean  @default(false)
  autorId    String
  autor      Usuario  @relation(fields: [autorId], references: [id])
  criadoEm   DateTime @default(now())

  @@index([viagemId, criadoEm])
}

// O que levar. A lista é uma só pra viagem; cada pessoa marca a sua.
model ViagemChecklistItem {
  id       Int    @id @default(autoincrement())
  viagemId Int
  viagem   Viagem @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  texto    String
  ordem    Int    @default(0)

  marcados ViagemChecklistMarcado[]

  @@index([viagemId, ordem])
}

model ViagemChecklistMarcado {
  id        Int                 @id @default(autoincrement())
  itemId    Int
  item      ViagemChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario             @relation(fields: [usuarioId], references: [id])

  @@unique([itemId, usuarioId])
}

// Foto ou vídeo da viagem. O arquivo fica no Vercel Blob; aqui só o link.
// A nota (1 a 3 estrelas) é dada só pela coordenação; null = ainda não
// avaliada. Os pontos de cada pessoa são a soma das notas dos envios dela.
model ViagemMidia {
  id            Int       @id @default(autoincrement())
  viagemId      Int
  viagem        Viagem    @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  autorId       String
  autor         Usuario   @relation(fields: [autorId], references: [id])
  tipo          TipoMidia
  url           String
  legenda       String?
  nota          Int?
  avaliadaPorId String?
  avaliadaPor   Usuario?  @relation("ViagemMidiaAvaliadaPor", fields: [avaliadaPorId], references: [id])
  criadoEm      DateTime  @default(now())

  @@index([viagemId, criadoEm])
  @@index([viagemId, autorId])
}
